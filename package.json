  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/qrcode-terminal": "0.12.2",
    "@types/supertest": "6.0.3",
    "qrcode-terminal": "0.12.0",
    "supertest": "7.3.1",
    "typescript": "7.0.2"
  }
